# Required
DAILY_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pipecat Cloud Configuration
# Optional: Pipecat Cloud API key
# - Required for production deployment: pipecat cloud deploy
# - Not needed for local dev with: python bot.py -t daily --port 7860
PIPECAT_CLOUD_API_KEY=

# Optional: Override process and suggestion LLM models
PROCESS_MODEL=gpt-4.1-nano
SUGGESTION_MODEL=gpt-4.1
